# Postgres. Locally you can run one in Docker; in production this is the
# pooled connection string from Neon, Vercel Postgres, Supabase, or similar.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Sessions are JWTs sealed with this. Generate one with:
#   openssl rand -base64 32
# Changing it logs everyone out — old cookies can no longer be decrypted.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

# Gmail delivery for follow-up reminders. Use a Google App Password, not the
# account password. Leave blank and reminders are written to the console
# instead, so the job stays testable offline.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# The reminder job accepts either of these:
#   CRON_KEY    — for a crontab or curl:  /api/cron/follow-ups?key=...
#   CRON_SECRET — set this on Vercel and its Cron sends it as a Bearer token.
CRON_KEY="any-long-random-string"
CRON_SECRET=""

# Where the links inside reminder emails point.
APP_URL="http://localhost:3000"
